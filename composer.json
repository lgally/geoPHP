{
  "name": "gally90/geophp",
  "license": [
    "GPL-2.0-or-later",
    "BSD-3-Clause"
  ],
  "type": "library",
  "description": "PHP 8.3+ maintained fork of geoPHP for geometry operations and spatial format conversion.",
  "keywords": [
    "geophp",
    "gis",
    "geometry",
    "converter",
    "linestring",
    "polygon",
    "wkt",
    "wkb",
    "kml",
    "gpx",
    "geojson",
    "twkb"
  ],
  "homepage": "https://github.com/gally90/geoPHP",
  "authors": [
    {
      "name": "Patrick Hayes",
      "role": "Original creator"
    },
    {
      "name": "Péter Báthory",
      "role": "Developer"
    },
    {
      "name": "Liam Gallagher",
      "role": "Maintainer"
    }
  ],
  "autoload": {
    "psr-4": {
      "geoPHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "geoPHP\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "php-coveralls/php-coveralls": "^2.7",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1",
    "phpbench/phpbench": "^1.4"
  },
  "suggest": {
    "ext-geos": "GEOS allows more advanced operations"
  },
  "scripts": {
    "tests": [
      "@performance",
      "@bench",
      "@unit",
      "@test-input"
    ],
    "analyze": [
      "@cs-warning",
      "@stan"
    ],
    "all": [
      "@analyze",
      "echo \"Let's cool down a bit before testing benchmark ...\" && sleep 1",
      "@tests"
    ],
    "cs": "phpcs",
    "cs-warning": "phpcs -w",
    "cs-fix": "phpcbf",
    "stan": "phpstan analyze --no-progress --debug --memory-limit=1G",
    "unit": "phpunit --no-coverage",
    "coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit"
    ],
    "test-input": "cd tests && php test.php && cd ..",
    "performance": "cd tests && php geometryPerformance.php && cd ..",
    "bench": "vendor/bin/phpbench run --report=aggregate --sleep 10000"
  }
}
